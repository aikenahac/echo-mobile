{
  "cli": {
    "version": ">= 9.0.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZWNob3JlYWRzLmFwcCQ",
        "EXPO_PUBLIC_API_URL": "https://echoreads.app/api",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_PROJECT": "echo"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZWNob3JlYWRzLmFwcCQ",
        "EXPO_PUBLIC_API_URL": "https://echoreads.app/api",
        "RELEASE_CHANNEL": "production",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_PROJECT": "echo"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
