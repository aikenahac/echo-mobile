{
  "expo": {
    "name": "Echo",
    "slug": "echo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/echo_icon.png",
    "scheme": "echo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.echoreads.mobile",
      "icon": "./assets/images/icons/echo.icon",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6BA8",
        "foregroundImage": "./assets/images/icons/echo_icon_foreground.png",
        "backgroundImage": "./assets/images/icons/echo_icon_background.png",
        "monochromeImage": "./assets/images/icons/echo_icon_monochrome.png"
      },
      "package": "app.echoreads.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 75,
          "resizeMode": "contain",
          "backgroundColor": "#FF6BA8"
        }
      ],
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://bugsink.aiken.si/",
          "organization": "bugsinkhasnoorgs"
        }
      ],
      "expo-secure-store",
      [
        "expo-asset",
        {
          "assets": [
            "./assets/images/google_icon.png",
            "./assets/images/covers/pachinko.jpg",
            "./assets/images/covers/piranesi.jpg",
            "./assets/images/covers/james.jpg"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/lib/assets/fonts/ArchivoCondensed-Black.ttf",
            "./src/lib/assets/fonts/ArchivoCondensed-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "expo-apple-authentication",
      "expo-image",
      "expo-status-bar",
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-image-picker",
        {
          "photosPermission": "Echo uses your photos to set your profile picture and collection covers.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      },
      "eas": {
        "projectId": "ef5a368c-66cf-496f-80ff-fe88b248f6bd"
      }
    },
    "owner": "aiken"
  }
}
