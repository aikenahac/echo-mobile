{
  "expo": {
    "name": "Echo",
    "slug": "echo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/echo_icon.png",
    "scheme": "echo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.echobook.app",
      "icon": "./assets/images/icons/app_icon_echo.icon",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icons/echo_icon_foreground.png",
        "backgroundImage": "./assets/images/icons/echo_icon_background.png",
        "monochromeImage": "./assets/images/icons/echo_icon_foreground.png"
      },
      "package": "club.echobook.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons/echo_icon_foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F212D"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-asset",
        {
          "assets": [
            "./assets/images/echo_logo.png",
            "./assets/images/google_icon.png",
            "./assets/images/apple_icon_light.png",
            "./assets/images/apple_icon_dark.png"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/lib/assets/fonts/ArchivoCondensed-Black.ttf",
            "./src/lib/assets/fonts/ArchivoCondensed-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "expo-apple-authentication",
      "expo-image",
      "expo-status-bar",
      "./plugins/with-ios-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9ba87fbc-711c-457e-ba0c-f6d275e8a1f7"
      }
    }
  }
}
